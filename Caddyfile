{
    admin off
    persist_config off
    auto_https off

    log {
        format json
        output stderr
        level DEBUG
    }

    frankenphp {
        php_ini post_max_size 30M
        php_ini upload_max_filesize 30M
    }
}

:{$PORT:80} {
    root * /app/public

    encode zstd br gzip

    file_server {
        hide .git
        hide .env*
    }

    php_server
}
